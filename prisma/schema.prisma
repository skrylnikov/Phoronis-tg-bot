// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id BigInt @id

  firstName String?
  lastName  String?
  userName  String?
  metaInfo  Json?   @default("{}")

  Message    Message[]
  Memory     Memory[]
  UserFact   UserFact[]
}

enum ChatType {
  PRIVATE
  GROUP
}

model Chat {
  id BigInt @id

  title    String
  chatType ChatType

  name                  String?
  greeting              String?
  selfieSaturdayEnabled Boolean? @default(false)
  inktoberEnabled       Boolean? @default(false)
  privateModeEnabled    Boolean? @default(false)

  Message Message[]
  Memory  Memory[]
}

enum MessageType {
  TEXT
  MEDIA
  VOICE
}

model Message {
  id BigInt

  chatId BigInt
  chat   Chat   @relation(fields: [chatId], references: [id])

  senderId BigInt
  sender   User   @relation(fields: [senderId], references: [id])

  sessionId        String?
  replyToMessageId BigInt?
  replyToMessage   Message? @relation("replies", fields: [replyToMessageId, chatId], references: [id, chatId])

  messageType MessageType

  text    String?
  media   String?
  summary String?
  sentAt  DateTime
  private Boolean? @default(false)
  Replies Message[] @relation("replies")

  @@id([chatId, id])
  @@index([sessionId])
}

model Memory {
  id        BigInt   @id @default(autoincrement())

  userId    BigInt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  chatId    BigInt
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  content   String
  isUser    Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isUser])
  @@index([chatId, isUser])
}

enum FactType {
  TEXT_STYLE
  FACT
  INTEREST
  NEGATIVE_INTEREST
}

model UserFact {
  id               BigInt   @id @default(autoincrement())
  userId           BigInt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  content          String
  type             FactType
  weight           Int      @default(1)
  confidence       Float    @default(0.5)
  sourceMessageId  BigInt?
  expiresAt        DateTime?

  usageCount       Int      @default(0)
  lastUsedAt       DateTime?
  impactScore      Float    @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  FactImpact       FactImpact[]
  FactHistory      FactHistory[]

  @@index([userId, type])
  @@index([userId, updatedAt])
  @@index([expiresAt])
  @@index([impactScore])
}

model FactImpact {
  id              BigInt   @id @default(autoincrement())
  factId          BigInt
  fact            UserFact @relation(fields: [factId], references: [id], onDelete: Cascade)

  usedInMessageId BigInt
  timestamp       DateTime @default(now())

  userReaction    String?
  messageReaction String?

  @@index([factId])
  @@index([usedInMessageId])
  @@index([timestamp])
}

model FactHistory {
  id              BigInt   @id @default(autoincrement())
  factId          BigInt
  fact            UserFact @relation(fields: [factId], references: [id], onDelete: Cascade)

  previousContent String
  newContent      String
  weightChange    Int
  changedAt       DateTime @default(now())
  reason          String

  @@index([factId])
}
