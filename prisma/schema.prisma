// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id BigInt @id

  firstName String?
  lastName  String?
  userName  String?
  metaInfo  Json?   @default("{}")

  Message         Message[]
  GuestInteraction GuestInteraction[]
  Memory          Memory[]
  UserFact        UserFact[]
  Subscription    Subscription[]
  PaymentOrder    PaymentOrder[]
  PurchaseSession PurchaseSession[]
  LimitNotice     LimitNotice[]
}

enum ChatType {
  PRIVATE
  GROUP
}

model Chat {
  id BigInt @id

  title    String
  chatType ChatType

  name                  String?
  greeting              String?
  selfieSaturdayEnabled Boolean? @default(false)
  inktoberEnabled       Boolean? @default(false)
  privateModeEnabled    Boolean? @default(false)

  Message                  Message[]
  GuestInteraction         GuestInteraction[]
  Memory                   Memory[]
  beneficiarySubscriptions Subscription[]    @relation("SubscriptionBenefitChat")
  PaymentOrder             PaymentOrder[]
  PurchaseSession          PurchaseSession[]
  LimitNotice              LimitNotice[]
}

enum SubscriptionPlan {
  WEEK
  MONTH
  QUARTER
  YEAR
}

enum PaymentOrderStatus {
  PENDING
  PAID
  REFUNDED
  EXPIRED
}

enum QuotaScope {
  USER
  CHAT
}

enum QuotaKind {
  PRIMARY_RESPONSE
  IMAGE
  VOICE
  ANALYSIS
}

enum LimitNoticeKind {
  LITE_FALLBACK
  IMAGE_LIMIT
  VOICE_LIMIT
}

model Subscription {
  id                String           @id @default(cuid())
  userId            BigInt
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  beneficiaryChatId BigInt
  beneficiaryChat   Chat             @relation("SubscriptionBenefitChat", fields: [beneficiaryChatId], references: [id], onDelete: Cascade)
  plan              SubscriptionPlan
  startsAt          DateTime
  endsAt            DateTime
  revokedAt         DateTime?
  createdAt         DateTime         @default(now())
  paymentOrder      PaymentOrder?

  @@index([userId, endsAt])
  @@index([beneficiaryChatId, endsAt])
}

model PaymentOrder {
  id                      String             @id @default(cuid())
  userId                  BigInt
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  beneficiaryChatId       BigInt
  beneficiaryChat         Chat               @relation(fields: [beneficiaryChatId], references: [id], onDelete: Cascade)
  plan                    SubscriptionPlan
  baseAmount              Int
  amount                  Int
  discountPercent         Int                @default(0)
  status                  PaymentOrderStatus @default(PENDING)
  termsAcceptedAt         DateTime
  termsVersion            String
  telegramPaymentChargeId String?            @unique
  subscriptionId          String?            @unique
  subscription            Subscription?      @relation(fields: [subscriptionId], references: [id])
  createdAt               DateTime           @default(now())
  expiresAt               DateTime
  paidAt                  DateTime?
  refundedAt              DateTime?

  @@index([userId, status])
  @@index([beneficiaryChatId, status])
  @@index([status, expiresAt])
}

model PurchaseSession {
  token             String   @id
  userId            BigInt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  beneficiaryChatId BigInt
  beneficiaryChat   Chat     @relation(fields: [beneficiaryChatId], references: [id], onDelete: Cascade)
  expiresAt         DateTime
  termsAcceptedAt   DateTime?
  termsVersion      String?
  createdAt         DateTime @default(now())
}

model QuotaUsage {
  id      String     @id @default(cuid())
  scope   QuotaScope
  ownerId BigInt
  chatId  BigInt     @default(0)
  kind    QuotaKind
  date    DateTime   @db.Date
  count   Int        @default(0)

  @@unique([scope, ownerId, chatId, kind, date])
}

model LimitNotice {
  id     String          @id @default(cuid())
  userId BigInt
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId BigInt
  chat   Chat            @relation(fields: [chatId], references: [id], onDelete: Cascade)
  kind   LimitNoticeKind
  sentAt DateTime        @default(now())

  @@unique([userId, chatId, kind])
}

model DailyAnalytics {
  date         DateTime @id @db.Date
  reportSentAt DateTime?
  updatedAt    DateTime @updatedAt
}

enum TelegramUpdateLane {
  NORMAL
  URGENT
}

enum TelegramUpdateStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model TelegramUpdate {
  updateId     BigInt               @id
  payload      Json
  partitionKey String
  lane         TelegramUpdateLane   @default(NORMAL)
  status       TelegramUpdateStatus @default(PENDING)
  attempts     Int                  @default(0)
  availableAt  DateTime             @default(now())
  leaseUntil   DateTime?
  workerId     String?
  receivedAt   DateTime             @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  lastError    String?

  @@index([status, lane, availableAt, updateId])
  @@index([partitionKey, lane, updateId, status])
}

enum BackgroundJobType {
  PAYMENT_BUYER_NOTIFICATION
  PAYMENT_BENEFICIARY_NOTIFICATION
  PAYMENT_ANALYTICS_NOTIFICATION
  USER_MESSAGE_ANALYSIS
}

enum BackgroundJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model BackgroundJob {
  id          String            @id @default(cuid())
  type        BackgroundJobType
  dedupeKey   String            @unique
  payload     Json
  status      BackgroundJobStatus @default(PENDING)
  attempts    Int               @default(0)
  availableAt DateTime          @default(now())
  leaseUntil  DateTime?
  workerId    String?
  createdAt   DateTime          @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime          @updatedAt
  lastError   String?

  @@index([status, availableAt, createdAt])
  @@index([status, leaseUntil])
}

enum MessageType {
  TEXT
  MEDIA
  VOICE
}

enum GuestInteractionStatus {
  PROCESSING
  ANSWERED
  FAILED
}

model Message {
  id BigInt

  chatId BigInt
  chat   Chat   @relation(fields: [chatId], references: [id])

  senderId BigInt
  sender   User   @relation(fields: [senderId], references: [id])

  sessionId        String?
  replyToMessageId BigInt?
  replyToMessage   Message? @relation("replies", fields: [replyToMessageId, chatId], references: [id, chatId])

  messageType MessageType

  text             String?
  media            String?
  summary          String?
  searchText       String?
  embedding        Unsupported("vector(384)")?
  embeddingVersion Int?
  sentAt           DateTime
  private          Boolean?                    @default(false)
  Replies          Message[]                   @relation("replies")
  sourceFacts      UserFact[]                  @relation("UserFactSourceMessage")

  @@id([chatId, id])
  @@index([sessionId])
  @@index([senderId])
}

model GuestInteraction {
  id           String                  @id @default(cuid())
  guestQueryId String                  @unique
  chatId       BigInt
  chat         Chat                    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId       BigInt
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId    BigInt?
  query        String
  referenceText String?
  answer       String?
  status       GuestInteractionStatus  @default(PROCESSING)
  error        String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  answeredAt   DateTime?

  @@index([chatId, createdAt])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

model Memory {
  id BigInt @id @default(autoincrement())

  userId BigInt
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  chatId BigInt
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  content          String
  isUser           Boolean
  embedding        Unsupported("vector(384)")?
  embeddingVersion Int?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([userId, isUser])
  @@index([chatId, isUser])
}

enum FactType {
  TEXT_STYLE
  FACT
  INTEREST
  NEGATIVE_INTEREST
}

model UserFact {
  id     BigInt @id @default(autoincrement())
  userId BigInt
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  content         String
  type            FactType
  weight          Int       @default(1)
  confidence      Float     @default(0.5)
  sourceChatId    BigInt?
  sourceMessageId BigInt?
  sourceMessage   Message?  @relation("UserFactSourceMessage", fields: [sourceChatId, sourceMessageId], references: [chatId, id], onDelete: SetNull)
  expiresAt       DateTime?

  usageCount       Int                         @default(0)
  lastUsedAt       DateTime?
  impactScore      Float                       @default(0)
  embedding        Unsupported("vector(384)")?
  embeddingVersion Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  FactImpact  FactImpact[]
  FactHistory FactHistory[]

  @@index([userId, type])
  @@index([userId, updatedAt])
  @@index([sourceChatId, sourceMessageId])
  @@index([expiresAt])
  @@index([impactScore])
}

model FactImpact {
  id     BigInt   @id @default(autoincrement())
  factId BigInt
  fact   UserFact @relation(fields: [factId], references: [id], onDelete: Cascade)

  usedInMessageId BigInt
  timestamp       DateTime @default(now())

  userReaction    String?
  messageReaction String?

  @@index([factId])
  @@index([usedInMessageId])
  @@index([timestamp])
}

model FactHistory {
  id     BigInt   @id @default(autoincrement())
  factId BigInt
  fact   UserFact @relation(fields: [factId], references: [id], onDelete: Cascade)

  previousContent String
  newContent      String
  weightChange    Int
  changedAt       DateTime @default(now())
  reason          String

  @@index([factId])
}
